# Optional settings. Nothing here is required and no cloud credentials are used.
# The application reads these as environment variables; it does not load this file by itself.
# PowerShell example for the current terminal:  $env:FINOPS_API_URL = "http://127.0.0.1:8000"

# SQLite file for the interactive demo (created automatically)
FINOPS_DB_PATH=runtime/finops_demo.db

# Scenario loaded when the database is created for the first time
# (normal, forgotten_server, cost_spike, budget_pressure, optimization_review)
FINOPS_DEFAULT_SCENARIO=normal

# Address of the FastAPI backend used by the Streamlit dashboard
FINOPS_API_URL=http://127.0.0.1:8000
